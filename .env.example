# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Opsional. Isi dengan URL REST API PHP di Laragon saat build produksi
# Contoh Laragon: http://localhost/sejati-maps/backend-php/api
VITE_API_BASE_URL=""

# Konfigurasi MySQL & Token PHP (untuk backend-php/config/db_config.php atau environment server)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sejati_maps
DB_USER=root
DB_PASS=
APP_AUTH_SECRET=
ADMIN_BOOTSTRAP_PASSCODE=
