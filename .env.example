# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: URL REST API backend-php di hosting produksi untuk APK Android
# Contoh hosting produksi (HTTPS): https://domain-anda.com/backend-php/api
# Catatan: Jangan isi localhost atau alamat preview AI Studio untuk build APK production.
VITE_API_BASE_URL=""

# Konfigurasi MySQL & Token PHP (untuk backend-php/config/db_config.php atau environment server)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sejati_maps
DB_USER=root
DB_PASS=
APP_AUTH_SECRET=
ADMIN_BOOTSTRAP_PASSCODE=
